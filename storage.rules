rules_version = '2';

// ============================================================
//  Storage Rules — PTEM (Fase 4)
// ------------------------------------------------------------
//  Todo archivo vive bajo el prefijo de SU academia:
//     academias/{academiaId}/archivos/…   (descargables: pdf, audio, video)
//     academias/{academiaId}/imagenes/…   (imágenes del contenido)
//  Aislamiento: leer requiere PERTENECER a esa academia (o super-admin);
//  escribir requiere poder EDITAR su contenido (director con plan pro|curso
//  o profesor con permisos editoriales) — espejo de firestore.rules.
//  Nada fuera de academias/** es accesible para clientes.
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() { return request.auth != null; }
    // Perfil del solicitante en Firestore (mismo modelo que firestore.rules).
    function miDoc() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    // Mismo criterio que firestore.rules: las claims se leen con
    // get(clave, default). Con notación de punto, un token sin `email_verified`
    // provoca un error de evaluación que deniega la expresión entera en la que
    // aparece, no un simple false.
    function esSupremo() {
      return autenticado()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in ['mihayolo228@gmail.com'];
    }
    function esSuper() {
      return esSupremo()
        || (autenticado()
          && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
          && miDoc().rol == 'superadmin');
    }
    // Prueba temporal vencida = no pertenece. MISMO cuerpo que pruebaVencida()
    // en firestore.rules (y que src/lib/accesoModelo.js): sin esta puerta, el
    // temario quedaba cerrado pero sus adjuntos —PDF, imágenes, audio— se
    // seguían descargando con la sesión que ya había vencido. Marcado como
    // prueba y sin fecha válida = vencido.
    function pruebaVencida() {
      return miDoc().get('esPrueba', false) == true
        && !(miDoc().get('pruebaHasta', null) is timestamp
             && miDoc().pruebaHasta > request.time);
    }
    function perteneceA(acaId) {
      return autenticado()
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && miDoc().academiaId == acaId
        && !pruebaVencida();
    }
    // --- Capacidades de la academia: MISMO cuerpo que en firestore.rules ---
    // Esta función derivaba el plan por su cuenta y le faltaban DOS cosas que
    // firestore.rules sí tenía: la promoción de tipo 'avanzado' a plan 'pro' y
    // el mapa de excepciones. Efecto real: una academia 'avanzado' con plan
    // 'base' podía editar su contenido y NO podía subir ni un archivo — el
    // director veía el editor completo, arrastraba un PDF y recibía un error de
    // permisos sin explicación. Si cambias esto, cámbialo también allí y en
    // src/lib/capacidades.js.
    function academiaDoc(acaId) {
      return firestore.get(/databases/(default)/documents/academias/$(acaId)).data;
    }
    function academiaPlanEfectivo(acaId) {
      return academiaDoc(acaId).get('tipo', 'basico') == 'avanzado'
        ? 'pro'
        : academiaDoc(acaId).get('planComercial', 'pro');
    }
    function capsDe(acaId) { return academiaDoc(acaId).get('capacidades', {}); }
    function academiaEditaContenido(acaId) {
      return capsDe(acaId).get('editorContenido', academiaPlanEfectivo(acaId) in ['pro', 'curso']);
    }
    // Director de la academia (con plan que edita) o profesor con permisos
    // editoriales. Los ARCHIVOS los gobierna `administrarRecursos` (Fase 6):
    // un profesor debe tener editarContenido + administrarRecursos para subir,
    // reemplazar o borrar. La granularidad por curso vive en Firestore.
    function puedeEditar(acaId) {
      return esSuper()
        || (perteneceA(acaId)
          && (
            (miDoc().rol == 'admin_escuela' && academiaEditaContenido(acaId))
            || (miDoc().rol == 'instructor'
              && miDoc().get('permisosEditor', {}).get('editarContenido', false) == true
              && miDoc().get('permisosEditor', {}).get('administrarRecursos', false) == true)
          ));
    }
    // Allowlist de contenido (espejo de src/lib/archivosModelo.js). Nunca
    // ejecutables ni tipos fuera de lista; límite duro de 50 MB (los límites
    // finos por categoría los aplica el cliente antes de subir).
    function archivoPermitido() {
      return request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/png|image/jpeg|image/webp|image/gif|audio/mpeg|video/mp4|video/webm'
        );
    }

    // --- Archivos de contenido por academia (aislados por prefijo) ---
    match /academias/{academiaId}/{carpeta}/{archivo=**} {
      // Leer/descargar: miembros de ESA academia (cualquier rol) o super.
      // Un alumno de A nunca descarga archivos de B, aunque tenga la URL
      // del objeto (las URL de descarga con token siguen siendo secretas
      // por archivo; el acceso directo por ruta queda cerrado aquí).
      allow read: if esSuper() || perteneceA(academiaId);
      // Subir/reemplazar: solo editores de esa academia, solo en las
      // carpetas conocidas y solo tipos de la allowlist.
      allow create, update: if puedeEditar(academiaId)
        && carpeta in ['archivos', 'imagenes']
        && archivoPermitido();
      // Borrar: solo editores de esa academia (limpieza de adjuntos).
      allow delete: if puedeEditar(academiaId);
    }

    // Todo lo demás: cerrado para clientes.
    match /{cualquiera=**} {
      allow read, write: if false;
    }
  }
}
