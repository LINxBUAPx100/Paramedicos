# Config de Firebase (cliente). Copia este archivo a `.env` y rellena los valores.
# Se obtienen en: consola Firebase → ⚙ Configuración del proyecto → Tus apps →
# app web (</>) → objeto `firebaseConfig`.
#
# Estos valores son PÚBLICOS (config de cliente: acaban en el bundle) y la
# seguridad real la dan las Security Rules. Aun así son OBLIGATORIOS: el build
# se detiene si falta alguno, para no publicar una app incapaz de conectarse.
# En GitHub Actions llegan como secrets del repositorio (ver deploy.yml).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ptem-a304f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ptem-a304f
VITE_FIREBASE_STORAGE_BUCKET=ptem-a304f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=944566588634
VITE_FIREBASE_APP_ID=

# --- App Check (OPCIONAL) -------------------------------------------------
# Clave de sitio de reCAPTCHA v3, en: consola Firebase → App Check → Apps →
# app web → reCAPTCHA v3. Mientras esté vacía, App Check no se inicializa y la
# app funciona igual; al rellenarla, la CSP abre sola los orígenes que
# reCAPTCHA necesita (ver vite.config.js).
#
# Es lo que impide que alguien copie la apiKey del bundle y use tu proyecto
# desde un script propio. Actívala DESPUÉS de restringir la clave por
# referente HTTP en Google Cloud.
VITE_APPCHECK_SITE_KEY=
