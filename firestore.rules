rules_version = '2';

// ============================================================
//  Security Rules — PTEM (auth + roles + progreso + panel)
// ------------------------------------------------------------
//  Modelo: academias/{codigo} · usuarios/{uid} · progreso/{uid} · intentos/{id}
//  Los roles viven en usuarios/{uid}.rol (sin custom claims todavía).
//  Jerarquía: superadmin (todo) > admin_escuela (su academia) >
//             instructor (ve su academia) > alumno.
//  El ADMIN SUPREMO se reconoce por su correo verificado de Auth
//  (no depende de su doc en Firestore), así nunca puede quedar fuera.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function esDueno(uid) { return autenticado() && request.auth.uid == uid; }
    // OJO al leer campos de miDoc(): SIEMPRE con .get(campo, default), nunca
    // con notación de punto. Un campo ausente accedido con punto no vale
    // false: lanza un error de evaluación que tumba la regla ENTERA donde
    // aparece. Como esSuper() abre casi todas las reglas, un perfil incompleto
    // —un alta que se cortó a medias, un doc de un esquema anterior— dejaba a
    // esa cuenta sin poder leer ni escribir nada en ninguna colección, y el
    // único síntoma era "Missing or insufficient permissions".
    function miDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    // Admin supremo: reconocido por su correo de Auth (bootstrap sin consola).
    // El correo debe estar VERIFICADO: sin esto, cualquiera que registre una
    // cuenta con ese correo en otro proveedor podría suplantarlo.
    //
    // Se leen las claims con get(clave, default) y NO con notación de punto.
    // Con el punto, un token que no traiga `email_verified` (sesión anónima,
    // token personalizado, o cualquier proveedor que no emita la claim) no
    // devuelve false: lanza un ERROR DE EVALUACIÓN, y eso tumba la expresión
    // ENTERA donde aparezca. Como esSuper() empieza por esSupremo(), toda regla
    // del tipo `esSuper() || <rama del alumno>` denegaba a ese usuario aunque su
    // propia rama fuese válida. Lo detectó el CI en la lectura de `temas` de un
    // alumno: "Property email_verified is undefined on object".
    function esSupremo() {
      return autenticado()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in ['mihayolo228@gmail.com'];
    }
    function esSuper() {
      return esSupremo()
        || (autenticado()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && miDoc().get('rol', '') == 'superadmin');
    }
    function academiaActiva(codigo) {
      return exists(/databases/$(database)/documents/academias/$(codigo))
        && get(/databases/$(database)/documents/academias/$(codigo)).data.estado == 'activo';
    }
    // --- PRUEBA TEMPORAL VENCIDA -------------------------------------------
    // Un código de `codigos` no inscribe a nadie: da permiso HASTA una fecha.
    // Al canjearlo el perfil queda marcado `esPrueba: true` y puede recibir
    // academiaId/grupoId para ver el temario real. Cuando `pruebaHasta` pasa,
    // esa pertenencia deja de contar aquí mismo: sin esto el bloqueo era solo
    // de pantalla (AuthContext) y el SDK seguía sirviendo cursos y temas a
    // quien conservara la sesión.
    //
    // Marcado como prueba pero SIN fecha válida = vencido. Un `esPrueba` sin
    // `pruebaHasta` no puede significar acceso indefinido.
    //
    // Espejo de pruebaVencida() en src/lib/accesoModelo.js: si cambias uno,
    // cambia el otro. No cuesta un get() extra (Firestore cachea miDoc()).
    function pruebaVencida() {
      return miDoc().get('esPrueba', false) == true
        && !(miDoc().get('pruebaHasta', null) is timestamp
             && miDoc().get('pruebaHasta', null) > request.time);
    }
    // ¿El solicitante es staff (instructor/maestro o admin de escuela) de esa academia?
    function esStaffDe(acaId) {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && (miDoc().get('rol', '') == 'instructor' || miDoc().get('rol', '') == 'admin_escuela')
        && miDoc().get('academiaId', null) == acaId
        && !pruebaVencida();
    }
    // ¿El solicitante es el director (admin de escuela) de esa academia?
    function esAdminDe(acaId) {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && miDoc().get('rol', '') == 'admin_escuela'
        && miDoc().get('academiaId', null) == acaId
        // Igual que esStaffDe: una prueba vencida no dirige nada. Sin esta
        // línea, quien tuviera rol de director y hubiera canjeado un código
        // temporal conservaba el panel de la academia al vencer.
        && !pruebaVencida();
    }
    // ¿El solicitante PERTENECE a esa academia (cualquier rol, alumno incluido)?
    function perteneceA(acaId) {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && miDoc().get('academiaId', null) == acaId
        // Prueba vencida = no pertenece (ver pruebaVencida() arriba).
        && !pruebaVencida();
    }

    // --- AISLAMIENTO POR PROGRAMA ------------------------------------------
    // El contenido ya no es uno solo: la academia imparte varias carreras,
    // cursos y certificaciones. El PROGRAMA de un alumno lo define su GRUPO,
    // y esa es la única fuente (espejo de src/lib/programasModelo.js).
    //
    // Por qué el grupo y no un campo en `usuarios`: sin Cloud Functions (plan
    // Spark) no hay forma de mantener sincronizada una copia en el perfil, y
    // un permiso rancio ahí no sería una molestia: sería una fuga de contenido.
    //
    // Coste: Firestore CACHEA los get() dentro de una misma petición, así que
    // listar los temas de un programa cuesta miDoc()+miGrupo() UNA vez, no N.
    // Profesor de ESTA academia con el permiso de códigos aprobado por su
    // director (usuarios/{uid}.puedeVerCodigos). Es lo que le habilita a
    // repartir acceso de ALUMNO: ya podía dar el código de su grupo, que hace
    // lo mismo para siempre y sin tope, así que una invitación —que caduca y
    // se agota— es más estrecha, no más ancha.
    function profesorConCodigos(academiaId) {
      return esStaffDe(academiaId)
        && miDoc().get('rol', '') == 'instructor'
        && miDoc().get('puedeVerCodigos', false) == true;
    }

    function miGrupoId() { return miDoc().get('grupoId', null); }
    function tengoGrupo() {
      return miGrupoId() != null
        && exists(/databases/$(database)/documents/grupos/$(miGrupoId()));
    }
    function miGrupo() {
      return get(/databases/$(database)/documents/grupos/$(miGrupoId())).data;
    }
    function misProgramas() {
      return [miGrupo().get('programaId', '')]
        .concat(miGrupo().get('programasExtra', []));
    }
    // ¿Este curso está dentro del alcance del grupo del solicitante?
    // Se compara contra el ID DEL DOCUMENTO del curso, que es lo que guarda
    // `grupos/{id}.programaId` (cursoId = academiaId__plantillaId).
    function cursoEnMiPrograma(cursoId) {
      return tengoGrupo() && misProgramas().hasAny([cursoId]);
    }
    // Lectura de contenido por un ALUMNO: su academia + publicado + SU programa.
    // Sin grupo NO lee nada: entró por código de academia o de prueba y todavía
    // no está en ningún plan de estudios (decisión explícita del producto).
    function alumnoLeeCurso(acaId, estado, cursoId) {
      return perteneceA(acaId) && estado == 'publicado' && cursoEnMiPrograma(cursoId);
    }
    // Plan EFECTIVO de una academia (espejo de src/lib/capacidades.js):
    // tipo 'avanzado' fuerza 'pro'; sin campo planComercial = 'pro' (academia
    // previa a los planes). Solo se evalúa en ESCRITURAS, nunca en lecturas.
    function academiaDoc(acaId) {
      return get(/databases/$(database)/documents/academias/$(acaId)).data;
    }
    function academiaPlanEfectivo(acaId) {
      return academiaDoc(acaId).get('tipo', 'basico') == 'avanzado'
        ? 'pro'
        : academiaDoc(acaId).get('planComercial', 'pro');
    }
    // EXCEPCIONES por academia (academias/{id}.capacidades). Solo las escribe
    // el super-admin: la regla de update del director está acotada con hasOnly
    // a logo/lema/colorHero/homeSecciones.
    function capsDe(acaId) { return academiaDoc(acaId).get('capacidades', {}); }
    // ¿El plan permite editar contenido? (pro|curso). ¿Otorgar permisos
    // editoriales a profesores? (solo pro).
    //
    // Espejo EXACTO de capacidadesDe() en src/lib/capacidades.js: la excepción
    // manda y, si no la hay, se deriva del plan. Antes las reglas ignoraban el
    // mapa de excepciones, así que la UI podía conceder una capacidad que el
    // backend negaba (y al revés). Y el mismo par de funciones vive ahora en
    // storage.rules con el MISMO cuerpo: la divergencia entre ambos ficheros
    // (Firestore aplicaba la promoción de 'avanzado' a pro y Storage no) dejaba
    // a las academias de tipo avanzado con plan base editando contenido pero
    // sin poder subir un solo archivo.
    // Si cambias esto, cámbialo en los tres sitios.
    function academiaEditaContenido(acaId) {
      return capsDe(acaId).get('editorContenido', academiaPlanEfectivo(acaId) in ['pro', 'curso']);
    }
    function academiaOtorgaPermisos(acaId) {
      return capsDe(acaId).get('permisosEditoriales', academiaPlanEfectivo(acaId) == 'pro');
    }
    // --- PROGRAMAS PROPIOS -------------------------------------------------
    // Qué TIPOS de programa puede crear una academia por su cuenta. Espejo de
    // `tiposQuePuedeCrear` en src/lib/programasModelo.js.
    //
    // Por omisión NADA: una academia recibe lo que el super-admin le clone y no
    // crea programas. Tener un plan caro no da derecho al contenido de otra
    // academia, y ésa es justamente la decisión que protege el trabajo de
    // R.E.S.C.A.T.E.
    //
    // `tum` NO se puede conceder por esta vía, ni escribiendo la lista a mano:
    // es el programa insignia de R.E.S.C.A.T.E. y clonarlo es una operación del
    // super-admin, no una capacidad que se regale. Por eso se comprueba aquí y
    // no solo en la aplicación.
    function tiposConcedidos(acaId) {
      return capsDe(acaId).get('programasPropios', []);
    }
    function academiaCreaPrograma(acaId, tipo) {
      return tipo is string
        && tipo != 'tum'
        && tipo in ['enfermeria', 'tsu', 'licenciatura', 'proteccion_civil', 'curso', 'certificacion']
        && tipo in tiposConcedidos(acaId);
    }
    // Permisos editoriales del solicitante (usuarios/{uid}.permisosEditor); un
    // mapa que SOLO escribe el director PRO o el super-admin.
    function permEditor() { return miDoc().get('permisosEditor', {}); }
    function instructorPermite(clave) { return permEditor().get(clave, false) == true; }
    // Profesor con permisos editoriales sobre UN curso concreto. Sin
    // `editarContenido` + curso en `cursosPermitidos` no edita nada.
    function profesorPuedeEditar(acaId, cursoId) {
      return esStaffDe(acaId)
        && miDoc().get('rol', '') == 'instructor'
        && instructorPermite('editarContenido')
        && cursoId in permEditor().get('cursosPermitidos', []);
    }
    // Rejilla FINA por campo para la escritura de un profesor: cada campo
    // sensible exige su permiso. `campo(clave)` = ese campo cambió en el diff.
    function cambia(clave) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([clave]);
    }
    function camposTemaSegunPermisos() {
      return (!cambia('quiz')        || instructorPermite('editarExamenes'))
        && (!cambia('actividades')   || instructorPermite('editarActividades'))
        && (!cambia('recursos')      || instructorPermite('administrarRecursos'))
        && (!cambia('estado')        || instructorPermite('publicarContenido'));
    }
    function cursoSegunPermisos() {
      return (!cambia('estado') || instructorPermite('publicarContenido'));
    }
    // Forma válida de la ACEPTACIÓN DE TÉRMINOS. Solo dos claves: la versión
    // aceptada (AAAA-MM-DD) y cuándo. La fecha tiene que ser la del SERVIDOR:
    // es la constancia de cuándo se aceptó un contrato, y el reloj de quien
    // acepta no puede decidirla. Ausente vale —quien todavía no ha aceptado no
    // tiene el campo—; presente, tiene esta forma y ninguna otra.
    function terminosFormaValidos() {
      return !('terminos' in request.resource.data)
        || (
          request.resource.data.terminos is map
          && request.resource.data.terminos.keys().hasOnly(['version', 'aceptadoEn'])
          && request.resource.data.terminos.keys().hasAll(['version', 'aceptadoEn'])
          && request.resource.data.terminos.version is string
          && request.resource.data.terminos.version.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.terminos.aceptadoEn == request.time
        );
    }
    // Forma válida del PASE DE REVISIÓN docente: solo esas cuatro claves, con
    // caducidad obligatoria en AAAA-MM-DD. Un pase sin fecha de caducidad sería
    // un rol permanente disfrazado, y por eso las reglas lo rechazan.
    function paseRevisorFormaValida() {
      return request.resource.data.revisorTemporal == null
        || (
          request.resource.data.revisorTemporal is map
          && request.resource.data.revisorTemporal.keys().hasOnly([
               'hasta', 'otorgadoPor', 'otorgadoEn', 'nota'
             ])
          && request.resource.data.revisorTemporal.keys().hasAll(['hasta'])
          && request.resource.data.revisorTemporal.hasta is string
          && request.resource.data.revisorTemporal.hasta.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        );
    }
    // Forma válida de `grupoIds`: los VARIOS grupos que lleva un profesor
    // (Fase 2). Ausente vale —un profesor de antes de esta fase no lo tiene—;
    // presente, tiene que ser una lista con tope. El tope no es pedagógico: sin
    // él, un documento de perfil podría crecer sin control.
    // El espejo en el cliente es MAX_GRUPOS en src/lib/gruposDeUsuario.js.
    function grupoIdsFormaValida() {
      return !('grupoIds' in request.resource.data)
        || (
          request.resource.data.grupoIds is list
          && request.resource.data.grupoIds.size() <= 40
        );
    }
    // Forma válida del mapa permisosEditor escrito por el director: solo las
    // 7 claves conocidas (6 booleanos + cursosPermitidos). Evita inyectar basura.
    function permisosEditorFormaValida() {
      return request.resource.data.permisosEditor is map
        && request.resource.data.permisosEditor.keys().hasOnly([
          'editarContenido', 'crearTemas', 'editarActividades', 'editarExamenes',
          'publicarContenido', 'administrarRecursos', 'cursosPermitidos']);
    }
    // Escritura de contenido por editores de academia (director/profesor):
    // - la versión sube EXACTAMENTE +1 (control de conflictos; nadie la
    //   reduce ni la manipula),
    // - los metadatos administrativos y de origen son intocables,
    // - el estado queda dentro del catálogo (borrador|publicado|archivado).
    // El super-admin no pasa por aquí (scripts de migración/clonación).
    function edicionContenidoValida() {
      return request.resource.data.get('version', 0) == resource.data.get('version', 0) + 1
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['academiaId', 'cursoId', 'temaId', 'plantillaId',
                      'plantillaOrigenId', 'versionOrigen', 'clonacion',
                      // 'origen' (sello de clonación/replicación, Fase 7) y
                      // 'replicacion' son huellas administrativas: si un editor
                      // pudiera tocarlas, ocultaría sus cambios a la replicación.
                      'origen', 'replicacion',
                      'creadoPor', 'creadoEn'])
        && request.resource.data.get('estado', 'borrador') in ['borrador', 'publicado', 'archivado'];
    }
    // Creación de contenido por editores de academia: firmada por su autor,
    // versión inicial 1 y estado del catálogo.
    function creacionContenidoValida() {
      return request.resource.data.get('creadoPor', null) == request.auth.uid
        && request.resource.data.get('version', 0) == 1
        && request.resource.data.get('estado', 'borrador') in ['borrador', 'publicado', 'archivado'];
    }
    // Canje de un código de prueba sobre el PROPIO perfil: el código debe
    // existir, estar activo y vigente, y pruebaHasta debe COPIAR su expiración
    // (nadie puede inventarse una fecha de prueba arbitraria).
    function codigoDoc(cod) {
      return get(/databases/$(database)/documents/codigos/$(cod)).data;
    }
    function canjeValido() {
      return ('codigoPrueba' in request.resource.data)
        && request.resource.data.codigoPrueba is string
        && exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigoPrueba))
        && codigoDoc(request.resource.data.codigoPrueba).estado == 'activo'
        && codigoDoc(request.resource.data.codigoPrueba).expira > request.time
        && request.resource.data.pruebaHasta == codigoDoc(request.resource.data.codigoPrueba).expira;
    }
    // --- Directorio público de academias ---
    // `directorio/{academiaId}` solo contiene datos de escaparate (nombre,
    // descripción, logo). Se usa además como INTERRUPTOR: que exista significa
    // que esa academia se admite por solicitud y NO por código.
    function enDirectorio(acaId) {
      return exists(/databases/$(database)/documents/directorio/$(acaId));
    }
    // Id determinista de la solicitud: un usuario tiene como mucho UNA por
    // academia. Evita el spam sin necesidad de contarlas, y permite a las
    // reglas encontrarla sin conocer un id aleatorio.
    function idSolicitudAcceso(uid, acaId) {
      return uid + '__' + acaId;
    }
    function solicitudAceptada(acaId) {
      return exists(/databases/$(database)/documents/solicitudesAcceso/$(idSolicitudAcceso(request.auth.uid, acaId)))
        && get(/databases/$(database)/documents/solicitudesAcceso/$(idSolicitudAcceso(request.auth.uid, acaId))).data.estado == 'aceptada';
    }

    // Unirse a un GRUPO por código (sobre el propio perfil): el grupo debe
    // existir, estar activo, y el academiaId nuevo debe ser LA academia del
    // grupo (unirse al grupo te une a su academia, que debe estar activa).
    function grupoDoc(cod) {
      return get(/databases/$(database)/documents/grupos/$(cod)).data;
    }
    function grupoValido() {
      return request.resource.data.grupoId is string
        && exists(/databases/$(database)/documents/grupos/$(request.resource.data.grupoId))
        && grupoDoc(request.resource.data.grupoId).estado == 'activo'
        && grupoDoc(request.resource.data.grupoId).academiaId == request.resource.data.academiaId
        && academiaActiva(request.resource.data.academiaId);
    }

    // Canje de una INVITACIÓN POR ROL sobre el propio perfil. Es la ÚNICA vía
    // por la que el propio usuario puede cambiar su `rol`, y por eso se valida
    // entera aquí y no se fía de nada que venga del cliente:
    //   · la invitación existe, está activa y no ha vencido,
    //   · no está agotada (maxUsos > 0 ⇒ usos < maxUsos),
    //   · el rol escrito es EXACTAMENTE el de la invitación,
    //   · ese rol sale del catálogo cerrado alumno|instructor|admin_escuela:
    //     'superadmin' NO se reparte por enlace, ni aunque alguien consiguiera
    //     escribirlo en el doc de la invitación,
    //   · la academia y el grupo escritos son los de la invitación.
    //
    // `resource.data.rol in [...]` acota también el ORIGEN: un superadmin no se
    // autodegrada por tocar un enlace de alumno.
    //
    // El contador `usos` lo escribe el propio invitado (regla de `invitaciones`
    // más abajo), así que limita enlaces repartidos de buena fe, no a un actor
    // hostil que ya tiene el código. Lo que sí se sostiene contra él es la
    // caducidad y la desactivación, que solo escribe el director.
    function invitacionDoc(cod) {
      return get(/databases/$(database)/documents/invitaciones/$(cod)).data;
    }
    function invitacionValida() {
      return ('invitacionUsada' in request.resource.data)
        && request.resource.data.invitacionUsada is string
        && exists(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacionUsada))
        && invitacionDoc(request.resource.data.invitacionUsada).estado == 'activo'
        && invitacionDoc(request.resource.data.invitacionUsada).expira > request.time
        && (
          invitacionDoc(request.resource.data.invitacionUsada).get('maxUsos', 0) == 0
          || invitacionDoc(request.resource.data.invitacionUsada).get('usos', 0)
             < invitacionDoc(request.resource.data.invitacionUsada).get('maxUsos', 0)
        )
        && invitacionDoc(request.resource.data.invitacionUsada).rol
             in ['alumno', 'instructor', 'admin_escuela']
        && request.resource.data.rol == invitacionDoc(request.resource.data.invitacionUsada).rol
        // `.get('rol', 'alumno')` y no `resource.data.rol`: un perfil al que
        // le falte el campo (alta a medias, esquema anterior) haría ERROR de
        // evaluación aquí, y un error tumba la regla entera — el usuario veía
        // «Missing or insufficient permissions» al activar su invitación. El
        // valor por defecto es el rol MÍNIMO, así que no abre nada: 'superadmin'
        // sigue fuera de la lista por ambos lados.
        && resource.data.get('rol', 'alumno') in ['alumno', 'instructor', 'admin_escuela']
        && request.resource.data.academiaId
             == invitacionDoc(request.resource.data.invitacionUsada).academiaId
        && academiaActiva(request.resource.data.academiaId)
        && request.resource.data.get('grupoId', null)
             == invitacionDoc(request.resource.data.invitacionUsada).get('grupoId', null);
    }

    // --- ACADEMIAS (el id del doc ES el código, p.ej. "AEP-2026") ---
    match /academias/{codigo} {
      // Consultar UN código concreto: cualquier autenticado (validar el código
      // al unirse). NUNCA listar: si un usuario pudiera enumerar las academias
      // podría autoasignarse a cualquiera sin conocer su código de invitación.
      allow get: if autenticado();
      allow list: if esSuper();
      // Alta/edición/baja: solo super-admin.
      allow write: if esSuper();
      // El director puede editar SOLO la personalización de SU academia
      // (logo, lema, color del hero y — roadmap F7 — las SECCIONES del Home)
      // — nunca estado/plan/tipo/nombre — y SOLO si su plan comercial incluye
      // esa capacidad (pro|curso). Sin campo planComercial = academia previa
      // a los planes → se trata como 'pro' (mismo default que capacidades.js).
      // homeSecciones debe ser lista (o null = default); su contenido lo
      // normaliza homeModelo.js al leer (basura ⇒ default, nunca rompe).
      // homeAcademia (Bloque L) sigue el mismo criterio: mapa o null, y su
      // forma la normaliza homeAcademiaModelo.js al leer. Validar aquí campo a
      // campo un objeto anidado sería una regla enorme y frágil; lo que sí
      // importa —que la ruta de un acceso salga de un catálogo cerrado y no de
      // texto libre— se resuelve en la normalización, que está probada.
      allow update: if esAdminDe(codigo)
        && resource.data.get('planComercial', 'pro') in ['pro', 'curso']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['logo', 'lema', 'colorHero', 'homeSecciones', 'homeAcademia'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['homeSecciones'])
          || request.resource.data.homeSecciones == null
          || request.resource.data.homeSecciones is list
        );

      // El director puede ACTIVAR la copia editable de SU academia, y nada más
      // de ese documento. Antes no podía: `contenido` no estaba en la lista de
      // arriba, así que el editor le decía «pide al administrador de la
      // plataforma» y ahí se acababa el camino. Si su plan le deja editar
      // contenido, poder encender su propia copia es parte de eso.
      //
      // Va en una regla aparte y no añadiendo 'contenido' a la lista de la
      // personalización porque lo que se admite aquí es más estrecho: SOLO ese
      // campo, y solo con los estados que produce la clonación. Mezclarlas
      // dejaría cambiar el logo y el origen del temario en la misma escritura.
      allow update: if esAdminDe(codigo)
        && academiaEditaContenido(codigo)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contenido'])
        && request.resource.data.contenido.estado in ['migrando', 'migrado', 'error'];
    }

    // --- DIRECTORIO público (escaparate de academias que admiten solicitudes) ---
    match /directorio/{academiaId} {
      // Cualquiera con sesión puede verlo: es justo su función, que alguien sin
      // academia encuentre la suya. Contiene SOLO datos de escaparate; nada de
      // plan, facturación ni estado comercial (eso vive en `academias`, cuyo
      // `list` sigue siendo exclusivo del super-admin).
      allow get, list: if autenticado();
      // Publicarse o retirarse: el director de ESA academia, o el super-admin.
      // Ojo: al publicarse, su academia deja de admitir entrada por código
      // (ver la regla de usuarios). Es una decisión con consecuencias.
      allow create, update: if (esSuper() || esAdminDe(academiaId))
        && request.resource.data.nombre is string
        && request.resource.data.keys().hasOnly(['nombre', 'descripcion', 'logo', 'actualizadoEn']);
      allow delete: if esSuper() || esAdminDe(academiaId);
    }

    // --- SOLICITUDES DE ACCESO (desde fuera de la academia) ---
    //  Distinta de `solicitudes`, que es para quien YA pertenece a una
    //  academia (pedir el siguiente módulo o ver códigos). Esta es de quien
    //  está fuera y quiere entrar, así que no puede compartir aquella regla:
    //  la suya exige que academiaId coincida con el del propio perfil.
    // --- CONTADORES de matrícula, uno por academia ---
    //
    // Guardan el último número emitido y solo suben. Quien reparte matrículas
    // es el staff de la academia —la recepción y la dirección— y el
    // super-admin, que además necesita escribir en el contador de la academia
    // de DESTINO al trasladar a alguien.
    //
    // La regla exige que el número no BAJE. Es la única forma de que un
    // cliente manipulado no pueda rebobinar el contador y provocar que la
    // siguiente alta repita una matrícula ya emitida.
    // --- PAGOS registrados en el mostrador ---
    //
    // Son los cobros que recepción apunta al dar de alta o al recibir una
    // mensualidad. NO son la pasarela: eso es el trabajo L y traerá su propia
    // colección con su webhook.
    //
    // UN PAGO NO SE EDITA. Es un asiento: describe algo que ocurrió, y algo que
    // ocurrió no cambia. Corregir un importe reescribiéndolo borra la única
    // prueba de lo que se apuntó primero, y con ella cualquier posibilidad de
    // cuadrar una caja. Una corrección se hace con otro asiento.
    //
    // Borrar lo puede el super-admin y nadie más, porque mientras no exista un
    // asiento de corrección hace falta una salida para un error de tecleo; y
    // porque quien lo hace tiene que ser quien responde de la contabilidad, no
    // quien cobró.
    match /pagos/{id} {
      allow read: if esSuper() || esStaffDe(resource.data.academiaId);
      allow create: if (esSuper() || esAdminDe(request.resource.data.academiaId))
        && request.resource.data.registradoPor == request.auth.uid
        && request.resource.data.academiaId is string
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 100000
        && request.resource.data.concepto is string
        && request.resource.data.metodo is string
        && request.resource.data.matricula is string;
      allow update: if false;
      allow delete: if esSuper();
    }

    match /contadores/{academiaId} {
      allow read: if esSuper() || esStaffDe(academiaId);
      allow create: if (esSuper() || esStaffDe(academiaId))
        && request.resource.data.ultimaMatricula is int
        && request.resource.data.ultimaMatricula >= 1;
      allow update: if (esSuper() || esStaffDe(academiaId))
        && request.resource.data.ultimaMatricula is int
        && request.resource.data.ultimaMatricula > resource.data.ultimaMatricula;
      // No se borran: borrar el contador reinicia la numeración de una
      // academia y devuelve a la circulación matrículas ya repartidas.
      allow delete: if false;
    }

    match /solicitudesAcceso/{id} {
      // Crear: solo sobre uno mismo, con el ID DETERMINISTA (uid__academiaId),
      // siempre 'pendiente', y solo hacia una academia activa que esté en el
      // directorio. El id determinista limita a una solicitud por academia.
      allow create: if autenticado()
        && id == request.auth.uid + '__' + request.resource.data.academiaId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && enDirectorio(request.resource.data.academiaId)
        && academiaActiva(request.resource.data.academiaId)
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 300;
      // Leer: el solicitante (ve en qué va lo suyo) y el staff de esa academia.
      allow read: if esDueno(resource.data.uid)
        || esSuper()
        || esStaffDe(resource.data.academiaId);
      // Resolver: solo el director o el super-admin, y solo el veredicto.
      // Aceptar NO mete al alumno en la academia: solo marca 'aceptada'. Es el
      // propio interesado quien completa su alta (regla de usuarios), así que
      // aquí no hace falta abrir escritura de un perfil ajeno.
      // `grupoAsignado` viaja en la solicitud porque el alta la completa el
      // interesado: es la única forma de que el director decida el grupo sin
      // abrir la escritura del perfil de otra persona. No hace falta validarlo
      // aquí a fondo — cuando el interesado lo escriba en su perfil, la regla
      // de `usuarios` exige `grupoValido()` sobre su propia academia.
      allow update: if (esSuper() || esAdminDe(resource.data.academiaId))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'resueltoPor', 'resueltoEn', 'motivo', 'grupoAsignado'])
        && request.resource.data.estado in ['aceptada', 'rechazada']
        && (request.resource.data.get('grupoAsignado', null) == null
            || request.resource.data.grupoAsignado is string);
      // Borrar: el solicitante (se arrepiente) o el director (limpieza).
      allow delete: if esDueno(resource.data.uid)
        || esSuper()
        || esAdminDe(resource.data.academiaId);
    }

    // --- GRUPOS internos de una academia (el id del doc ES el código) ---
    match /grupos/{codigo} {
      // Consultar un código concreto: cualquier autenticado (para unirse).
      allow get: if autenticado();
      // Listar: super-admin o staff de esa academia.
      allow list: if esSuper() || esStaffDe(resource.data.academiaId);
      // Crear/renombrar/activar/borrar: super-admin o el DIRECTOR de esa
      // academia (los profesores no crean ni renombran grupos).
      allow create: if (esSuper() || esAdminDe(request.resource.data.academiaId))
        && request.resource.data.nombre is string
        && request.resource.data.estado == 'activo';
      // El DIRECTOR gobierna su grupo entero, incluido el PROGRAMA que cursa
      // (programaId/programasExtra): es la llave del contenido que verán sus
      // alumnos, así que un profesor no la toca (ver el allow update de abajo).
      allow update, delete: if esSuper() || esAdminDe(resource.data.academiaId);
      // Los PROFESORES de la academia pueden ajustar SOLO la visibilidad del
      // contenido para el grupo (qué módulos/temas ven los alumnos). NO pueden
      // cambiar `programaId`: eso movería al grupo entero de plan de estudios.
      allow update: if esStaffDe(resource.data.academiaId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['modulosOcultos', 'temasOcultos']);
    }

    // --- REPORTES de problemas en temas (los revisa el super-admin) ---
    match /reportes/{id} {
      // Cualquier usuario autenticado reporta, firmando con su uid.
      allow create: if autenticado()
        && request.resource.data.uid == request.auth.uid;
      // Solo el super-admin los lee, resuelve o borra.
      allow read, update, delete: if esSuper();
    }

    // --- USUARIOS ---
    match /usuarios/{uid} {
      // El propio usuario, el super-admin, o el staff de su misma academia (para
      // que el maestro/admin vea a sus alumnos).
      allow read: if esDueno(uid) || esSuper() || esStaffDe(resource.data.academiaId);

      // Alta: solo tu propio doc, y siempre como 'alumno' (nadie se autonombra rol alto).
      allow create: if esDueno(uid)
        && request.resource.data.rol == 'alumno';

      // Edición propia: NO puedes cambiar tu rol ni tu estado; solo puedes fijar
      // academiaId a una academia que EXISTA y esté ACTIVA (unirse por código),
      // y tu acceso de prueba solo puede venir de un código VÁLIDO (canje).
      allow update: if esDueno(uid)
        // LISTA BLANCA: el propio usuario solo toca sus datos personales y los
        // campos de auto-servicio (unirse por código / canjear prueba). Sin
        // esto, todo campo NO enumerado más abajo quedaba escribible por su
        // dueño — incluidos `modulosDesbloqueados` (un alumno se desbloqueaba los
        // módulos que su grupo tiene ocultos) y `puedeVerCodigos` (un profesor
        // se auto-aprobaba el acceso a los códigos, saltándose la aprobación
        // del director). Ambos campos tienen sus propias reglas más abajo:
        // solo staff / solo director. Escribirlos aquí queda cerrado.
        //   nombre, email  → cambiarMiNombre / asegurarPerfil (lib/firebase/auth.js)
        //   academiaId, grupoId, esPrueba
        //                  → unirseAcademia (lib/firebase/usuarios.js),
        //                    unirseAGrupo   (lib/firebase/grupos.js)
        //   codigoPrueba, pruebaHasta, (+academiaId, grupoId)
        //                  → canjearCodigo (lib/firebase/codigos.js)
        //   rol, invitacionUsada, (+academiaId, grupoId, esPrueba)
        //                  → canjearInvitacion (lib/firebase/invitaciones.js).
        //     `rol` está en la lista, pero SOLO se deja cambiar respaldado por
        //     una invitación válida (cláusula de más abajo). Sin ella, sigue
        //     siendo inmutable para su dueño.
        //   terminos       → aceptarTerminos (lib/firebase/auth.js). Es el
        //     ÚNICO campo que el usuario escribe sobre sí mismo sin que se lo
        //     conceda nadie, y tiene que serlo: aceptar un contrato es un acto
        //     personal. Su forma se acota abajo (terminosFormaValidos) para que
        //     no sirva de hueco por donde meter cualquier otra cosa.
        //   telefono, matricula
        //                  → canjearInvitacion, cuando la invitación viene de un
        //     alta de recepción. Son datos que recepción ya capturó y que el
        //     perfil recibe al activarse; ninguno de los dos es libre (ver las
        //     cláusulas de abajo).
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'nombre', 'email', 'academiaId', 'grupoId',
             'esPrueba', 'pruebaHasta', 'codigoPrueba',
             'rol', 'invitacionUsada', 'terminos', 'telefono', 'matricula'])
        && terminosFormaValidos()
        // Los permisos editoriales NUNCA los edita el propio usuario (un
        // profesor no se auto-concede acceso): solo el director PRO / super.
        // Redundante con la lista blanca de arriba, y a propósito: si algún día
        // se amplía esa lista, esta barrera sigue en pie.
        // `grupoIds` va en la misma barrera y por el mismo motivo: es el
        // director quien reparte los grupos de un profesor. Si un profesor
        // pudiera escribirlo, se añadiría a sí mismo los grupos que quisiera y
        // vería en su panel a los alumnos de sus compañeros. Ya está fuera de
        // la lista blanca de arriba; esto lo deja explícito para que ampliarla
        // algún día no lo cuele sin querer.
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['permisosEditor', 'grupoIds'])
        // El ROL solo se mueve solo si lo respalda una INVITACIÓN POR ROL. Se
        // pone la igualdad primero para que el caso normal (editar el nombre,
        // unirse por código) no gaste una lectura extra: `||` corta.
        && (
          request.resource.data.get('rol', 'alumno') == resource.data.get('rol', 'alumno')
          || invitacionValida()
        )
        // Con `.get(campo, default)` en LOS DOS lados: un perfil incompleto
        // (sin `rol`, sin `estado` o sin `academiaId`) podía leerse y pintarse,
        // pero no aceptaba NINGUNA escritura de su dueño —ni cambiar el nombre,
        // ni unirse por código, ni canjear la invitación— porque comparar un
        // campo ausente es un error de evaluación, no un `false`. Rellenar el
        // hueco con el valor por defecto del alta no concede nada: 'activo' y
        // 'alumno' son exactamente lo que `asegurarPerfil` escribe al crearlo.
        && request.resource.data.get('estado', 'activo') == resource.data.get('estado', 'activo')
        // Unirse a una academia. DOS vías, nunca una tercera:
        //   · por CÓDIGO, solo si la academia NO está en el directorio;
        //   · por APROBACIÓN, si su solicitud ya está aceptada.
        // El porqué del veto por directorio: el id del doc de una academia ES
        // su código, así que listarla en un directorio público lo revela. Si
        // además se pudiera entrar con el código, el directorio equivaldría a
        // una puerta abierta. Publicarse en el directorio, por tanto, cambia el
        // modo de acceso a "solo por aprobación". Los miembros actuales no se
        // ven afectados: ya tienen su academiaId puesto.
        //   · por INVITACIÓN POR ROL, que vale INCLUSO si la academia está en
        //     el directorio: ahí no hay código que adivinar, hay un enlace que
        //     el director emitió a propósito.
        && (
          request.resource.data.get('academiaId', null) == resource.data.get('academiaId', null)
          || (academiaActiva(request.resource.data.academiaId)
              && !enDirectorio(request.resource.data.academiaId))
          || (academiaActiva(request.resource.data.academiaId)
              && solicitudAceptada(request.resource.data.academiaId))
          || invitacionValida()
        )
        && (
          request.resource.data.get('pruebaHasta', null) == resource.data.get('pruebaHasta', null)
          || canjeValido()
        )
        // Cambiar de GRUPO por cuenta propia solo vale como parte de un ALTA:
        // se entra a un grupo cuando no se tenía ninguno, al cambiar de
        // academia, con un canje de código o con una invitación por rol.
        // Saltar de un grupo a otro DENTRO de la misma academia es del director
        // (su regla está más abajo): el grupo lleva el `programaId`, es decir el
        // PLAN DE ESTUDIOS que decide qué cursos y temas se leen, así que un
        // alumno que se reasignara el grupo se auto-asignaría otro plan y el
        // aislamiento por programa quedaría decorativo.
        // Vaciar el grupo tampoco es libre: sin esa condición el salto se haría
        // en dos escrituras (salir del grupo y volver a entrar donde se quiera).
        && (
          request.resource.data.get('grupoId', null) == resource.data.get('grupoId', null)
          || (
            (
              resource.data.get('grupoId', null) == null
              || request.resource.data.get('academiaId', null) != resource.data.get('academiaId', null)
              || canjeValido()
              || invitacionValida()
            )
            && (
              request.resource.data.get('grupoId', null) == null
              || grupoValido()
            )
          )
        )
        // La marca de PRUEBA solo cambia con un canje válido o al unirse de
        // verdad (cambio de academia/grupo validado por las cláusulas de arriba,
        // o una invitación por rol: un alumno de prueba al que su director
        // invita como profesor de SU MISMA academia no cambia de academia ni de
        // grupo, y aun así deja de ser una cuenta de prueba).
        // MATRÍCULA: solo la que dice SU PROPIA invitación, y solo si no
        // tenía. Recepción la reservó con el contador al dar el alta; aquí el
        // perfil se limita a recogerla.
        //
        // Atarla al documento de la invitación es lo que hace segura la
        // apertura: sin esa cláusula, cualquiera con una invitación válida
        // podría escribirse la matrícula que quisiera —incluida la de otro—, y
        // el contador dejaría de ser la única fuente de números.
        && (
          request.resource.data.get('matricula', '') == resource.data.get('matricula', '')
          || (
            resource.data.get('matricula', '') == ''
            && invitacionValida()
            && request.resource.data.matricula
                 == invitacionDoc(request.resource.data.invitacionUsada).get('matricula', '')
          )
        )
        // TELÉFONO: texto corto, y solo respaldado por una invitación o por el
        // propio interesado escribiendo el suyo. No decide nada; se acota la
        // forma para que no sirva de hueco por donde meter cualquier cosa.
        && (
          request.resource.data.get('telefono', '') == resource.data.get('telefono', '')
          || (request.resource.data.telefono is string
              && request.resource.data.telefono.size() <= 20)
        )
        && (
          request.resource.data.get('esPrueba', false) == resource.data.get('esPrueba', false)
          || canjeValido()
          || request.resource.data.get('academiaId', null) != resource.data.get('academiaId', null)
          || request.resource.data.get('grupoId', null) != resource.data.get('grupoId', null)
          || invitacionValida()
        );

      // El director (admin_escuela) gestiona a los miembros de SU academia:
      // puede alternar alumno <-> instructor, activar/suspender, moverlos de
      // grupo y aprobar el acceso a códigos. Nunca a sí mismo, nunca a otro
      // admin/superadmin, no puede moverlos de academia, y NO puede tocar
      // ningún otro campo del perfil (affectedKeys lo acota técnicamente).
      allow update: if esAdminDe(resource.data.academiaId)
        && request.auth.uid != uid
        && resource.data.rol in ['alumno', 'instructor']
        && request.resource.data.rol in ['alumno', 'instructor']
        && request.resource.data.academiaId == resource.data.academiaId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['rol', 'estado', 'grupoId', 'grupoIds', 'puedeVerCodigos', 'matricula'])
        // MATRÍCULA: el director solo puede EMITIRLA, nunca reescribirla.
        //
        // Emitir es pasar de vacía a un número que la transacción del contador
        // acaba de reservar. Reescribir una ya emitida es otra cosa: sería la
        // forma de darle a dos personas el mismo número desde la interfaz, sin
        // pasar por el contador y sin que nada lo impidiera. Cambiarla solo
        // ocurre en un traslado de academia, y los traslados son del
        // super-admin.
        //
        // La forma se comprueba aquí y no solo en el cliente: dos letras y
        // siete dígitos. Una regla que confía en que el cliente formatee bien
        // no está comprobando nada.
        && (
          request.resource.data.get('matricula', '') == resource.data.get('matricula', '')
          || (
            resource.data.get('matricula', '') == ''
            && request.resource.data.matricula is string
            && request.resource.data.matricula.matches('^[A-Z]{2}[0-9]{7}$')
          )
        )
        // Si asigna grupo, debe ser un grupo de SU academia (o quitarlo).
        && (
          request.resource.data.get('grupoId', null) == resource.data.get('grupoId', null)
          || request.resource.data.get('grupoId', null) == null
          || (
            exists(/databases/$(database)/documents/grupos/$(request.resource.data.grupoId))
            && grupoDoc(request.resource.data.grupoId).academiaId == resource.data.academiaId
          )
        )
        // `grupoIds`: los VARIOS grupos de un profesor (Fase 2). Aquí solo se
        // valida la FORMA —lista de textos y con tope—, no que cada id sea de
        // esta academia, y es una decisión, no un olvido:
        //
        //  · comprobar cada elemento costaría un `get()` por grupo, y las
        //    reglas admiten 10 por petición: un profesor con 11 grupos dejaría
        //    de poder ser editado;
        //  · y sobre todo, `grupoIds` NO CONCEDE NADA. Es un filtro de
        //    pantalla. Todo lo que ese profesor pueda leer sigue pasando por
        //    `esStaffDe(academiaId)` en su propia colección, así que un id
        //    ajeno colado en la lista no abre ninguna puerta: aparece en un
        //    desplegable cuyas lecturas se deniegan igual.
        //
        // El `grupoId` de la línea de arriba SÍ se comprueba contra la
        // academia, porque ese campo sí decide plan de estudios para un alumno.
        && grupoIdsFormaValida();

      // El DIRECTOR PRO concede/retira los PERMISOS EDITORIALES a los
      // PROFESORES de SU academia (Fase 6): SOLO el campo permisosEditor, con
      // forma válida, y solo si su plan otorga permisos editoriales (pro).
      // Nunca a sí mismo, nunca a un director/superadmin, nunca de otra
      // academia (esAdminDe fija la academia; rol == instructor fija el destino).
      allow update: if esAdminDe(resource.data.academiaId)
        && request.auth.uid != uid
        && resource.data.rol == 'instructor'
        && request.resource.data.rol == 'instructor'
        && academiaOtorgaPermisos(resource.data.academiaId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permisosEditor'])
        && permisosEditorFormaValida();

      // El STAFF (profesor o director) puede HABILITAR módulos a los alumnos
      // de su academia: SOLO el campo modulosDesbloqueados (anula lo oculto del
      // grupo para ese alumno, nada más).
      allow update: if esStaffDe(resource.data.academiaId)
        && resource.data.rol == 'alumno'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['modulosDesbloqueados']);

      // Super-admin puede gestionar cualquier usuario (incluye al supremo
      // promoviendo su propio doc a rol 'superadmin' en su primer acceso).
      allow write: if esSuper();
    }

    // --- PROGRESO (privado por usuario; el super-admin puede limpiarlo al
    //     eliminar una cuenta) ---
    match /progreso/{uid} {
      allow read: if esDueno(uid) || esSuper();
      // El progreso solo lo escribe su dueño, y SOLO con la forma que produce
      // ProgressContext (leidos/quizzes/examenes/updatedAt). Antes esto era un
      // `write` sin validar: un doc de Firestore admite 1 MB y aquí escribe el
      // cliente con debounce, así que cualquier autenticado podía usar su
      // propio progreso como almacenamiento arbitrario. Los topes espejan la
      // app: `examenes` se recorta a 20 en ProgressContext.registrarExamen, y
      // `leidos`/`quizzes` van indexados por temaId (el temario no llega a 500).
      //   OJO: `tema` (claro/oscuro) es preferencia del DISPOSITIVO y nunca se
      //   sincroniza, por eso no está en la lista.
      allow create, update: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['leidos', 'quizzes', 'examenes', 'updatedAt'])
        && request.resource.data.get('leidos', {}).keys().size() <= 500
        && request.resource.data.get('quizzes', {}).keys().size() <= 500
        && request.resource.data.get('examenes', []).size() <= 20;
      // Borrado: su dueño, o el super-admin al eliminar la cuenta
      // (admin.js:eliminarUsuario). En un `delete` no hay request.resource, por
      // eso va aparte de la validación de forma de arriba.
      allow delete: if esDueno(uid) || esSuper();
    }

    // --- CÓDIGOS de acceso temporal (prueba del servicio) ---
    match /codigos/{codigo} {
      // Canjear: cualquier autenticado puede CONSULTAR un código concreto.
      allow get: if autenticado();
      // Listarlos: el super-admin (todos) o el director (los de su academia).
      allow list: if esSuper() || esAdminDe(resource.data.academiaId);
      // Crear: super-admin, o director para SU academia. Siempre a futuro,
      // activo y firmado por quien lo crea.
      allow create: if (esSuper() || esAdminDe(request.resource.data.academiaId))
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == 'activo'
        && request.resource.data.expira > request.time;
      // Desactivar/reactivar/borrar: super-admin o el director de su academia.
      allow update, delete: if esSuper() || esAdminDe(resource.data.academiaId);
    }

    // --- INVITACIONES POR ROL (el id del doc ES el código, INV-AEP-P-K3M9) ---
    //  Academia y grupo ya tenían su código, pero ninguno decía COMO QUÉ entra
    //  la persona. Esta colección sí: cada doc lleva un `rol`, y canjearla es
    //  la única vía por la que alguien puede cambiar su propio rol (ver
    //  `invitacionValida()` arriba y la regla de update de `usuarios`).
    match /invitaciones/{codigo} {
      // Consultar UNA invitación concreta: cualquier autenticado (para
      // canjearla). Nunca se enumeran sin filtro, igual que las academias.
      allow get: if autenticado();
      // Listarlas: SOLO el super-admin y el director de esa academia.
      //
      // Un profesor NO, ni con `puedeVerCodigos` aprobado. Ese permiso existe
      // para que reparta los códigos de academia y de grupo, que meten a todo
      // el mundo como alumno; una invitación por rol reparte el rol, y entre
      // ellas está la de 'admin_escuela'. Poder LEER la lista es poder copiar
      // el enlace de director aunque no pueda crearlo.
      // El profesor con permiso ve SOLO las que él emitió: la consulta debe
      // filtrar por `creadoPor`, porque si un solo documento de los devueltos
      // no cumple, Firestore rechaza la consulta entera. Así no puede leer —ni
      // copiar— el enlace de director que emitió su jefe.
      allow list: if esSuper()
        || esAdminDe(resource.data.academiaId)
        || (
          profesorConCodigos(resource.data.academiaId)
          && resource.data.rol == 'alumno'
          && resource.data.creadoPor == request.auth.uid
        );

      // Crear: super-admin y DIRECTOR, cualquier rol. Y el PROFESOR con el
      // permiso de códigos aprobado, SOLO invitaciones de alumno.
      //
      // Por qué el profesor sí puede ya: con `puedeVerCodigos` reparte el
      // código de su grupo, que mete a quien sea como alumno de forma
      // permanente y sin tope de usos. Una invitación de alumno hace lo mismo
      // pero caduca y se agota: es la versión estrecha de lo que ya tenía.
      // Lo que sigue sin poder es repartir ROLES —instructor o admin_escuela—,
      // porque ahí sí se estaría fabricando un ascenso.
      //
      // El rol sale del catálogo CERRADO. 'superadmin' no está y no puede
      // estar: no es un rol de academia, y una invitación es un enlace que
      // circula por WhatsApp.
      allow create: if request.resource.data.academiaId is string
        && (
          esSuper()
          || esAdminDe(request.resource.data.academiaId)
          || (
            profesorConCodigos(request.resource.data.academiaId)
            && request.resource.data.rol == 'alumno'
          )
        )
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.rol in ['alumno', 'instructor', 'admin_escuela']
        && request.resource.data.estado == 'activo'
        && request.resource.data.expira > request.time
        && request.resource.data.usos == 0
        && request.resource.data.maxUsos is int
        && request.resource.data.maxUsos >= 0
        // MATRÍCULA de un alta de recepción. La invitación puede traerla
        // —recepción la reservó con el contador— y el perfil la copiará tal
        // cual al canjearse. Por eso su FORMA se comprueba aquí: si no, una
        // invitación con basura en ese campo la metería en el perfil.
        && (
          request.resource.data.get('matricula', '') == ''
          || (request.resource.data.matricula is string
              && request.resource.data.matricula.matches('^[A-Z]{2}[0-9]{7}$'))
        )
        // Si lleva grupo, debe ser un grupo de ESA academia (no se invita al
        // grupo de otra escuela).
        && (
          request.resource.data.get('grupoId', null) == null
          || (
            exists(/databases/$(database)/documents/grupos/$(request.resource.data.grupoId))
            && grupoDoc(request.resource.data.grupoId).academiaId == request.resource.data.academiaId
          )
        );

      // Administrarla (DIRECTOR): solo estado / nota / tope de usos. El ROL, la
      // ACADEMIA y la CADUCIDAD son INMUTABLES a propósito: si el rol pudiera
      // editarse, un enlace ya repartido como "alumno" se convertiría en uno de
      // "director" en manos de quien ya lo tiene. Para cambiar el rol se emite
      // otra invitación.
      // El profesor puede desactivar o retocar LAS SUYAS: quien puede emitir
      // un enlace tiene que poder apagarlo sin ir a pedírselo al director.
      allow update: if (
          esAdminDe(resource.data.academiaId)
          || (
            profesorConCodigos(resource.data.academiaId)
            && resource.data.rol == 'alumno'
            && resource.data.creadoPor == request.auth.uid
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'nota', 'maxUsos'])
        && request.resource.data.estado in ['activo', 'inactivo']
        && request.resource.data.maxUsos is int
        && request.resource.data.maxUsos >= 0;

      // Marcar el USO al canjear: lo escribe el invitado y SOLO puede sumar uno
      // al contador. No toca rol, estado ni vigencia. Va en una regla aparte
      // porque el permiso es de otro sujeto, no del director.
      allow update: if autenticado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usos', 'ultimoUso'])
        && request.resource.data.usos == resource.data.get('usos', 0) + 1;

      // El super-admin, sin acotar: es quien migra `academiaId` al cambiar el
      // código de una academia (admin.js:cambiarCodigoAcademia), y esa
      // escritura no cabe en la lista del director. Mismo criterio que en
      // `codigos` e `intentos`.
      allow update: if esSuper();

      allow delete: if esSuper() || esAdminDe(resource.data.academiaId);
    }

    // --- SOLICITUDES de acceso ---
    //  tipo 'modulo'  → alumno terminó un módulo y pide el siguiente.
    //  (el valor 'modulo' es DATO PERSISTIDO desde antes del renombrado
    //   Fase→Módulo: ya significaba el nivel superior, así que no cambia.)
    //  tipo 'codigos' → profesor pide ver los códigos de academia/grupos.
    match /solicitudes/{id} {
      // Crear: el propio usuario, firmando con su uid, siempre 'pendiente'
      // y sobre SU academia (no puede sembrar solicitudes en otra).
      allow create: if autenticado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        // perteneceA() y no una comparación suelta: una PRUEBA VENCIDA deja de
        // pertenecer a la academia, y con ella se cierra también esta puerta.
        && perteneceA(request.resource.data.academiaId);
      // Leer: el dueño (consulta el estado de las suyas), el super-admin o
      // el staff de esa academia (las atiende en su panel).
      allow read: if esDueno(resource.data.uid)
        || esSuper()
        || esStaffDe(resource.data.academiaId);
      // Resolver: módulo → cualquier staff de la academia; códigos → solo el
      // director o el super-admin (un profesor no se auto-aprueba: además,
      // puedeVerCodigos solo lo escribe el director/super en usuarios).
      allow update: if esSuper()
        || esAdminDe(resource.data.academiaId)
        || (esStaffDe(resource.data.academiaId) && resource.data.tipo == 'modulo');
      allow delete: if esSuper() || esAdminDe(resource.data.academiaId);
    }

    // --- INTENTOS de examen de módulo ---
    // --- LIBRO DE CALIFICACIONES (evaluaciones del maestro) ---
    // Separado de `intentos` a propósito: un intento lo genera el alumno y es
    // repetible; una calificación la pone el staff y es un juicio. Mezclarlos
    // en la misma colección obligaría a que las reglas distinguieran quién
    // escribió qué, y ahí es donde se cuelan los errores.
    match /evaluaciones/{id} {
      // Leer: el staff de la academia, y los alumnos que PERTENECEN a ella
      // (necesitan ver el título y la fecha de lo que se les califica).
      // La consulta del cliente filtra por academiaId; sin ese filtro la regla
      // no se puede satisfacer y Firestore deniega la lista entera.
      allow get, list: if esSuper()
        || esStaffDe(resource.data.academiaId)
        || perteneceA(resource.data.academiaId);
      // Crear y editar: el staff de ESA academia. Un profesor evalúa a su
      // grupo, así que aquí no se distingue de un director; lo que un profesor
      // no puede es BORRAR (más abajo).
      allow create: if (esSuper() || esStaffDe(request.resource.data.academiaId))
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 120
        && request.resource.data.ponderacion is number
        && request.resource.data.ponderacion > 0
        && request.resource.data.ponderacion <= 100
        && request.resource.data.creadoPor == request.auth.uid;
      // La academia es inmutable: nadie mueve una evaluación a otra academia.
      allow update: if (esSuper() || esStaffDe(resource.data.academiaId))
        && request.resource.data.academiaId == resource.data.academiaId;
      // Borrar: director o super. Borrar una evaluación tira TODAS sus notas,
      // y eso no es una operación de rutina.
      allow delete: if esSuper() || esAdminDe(resource.data.academiaId);
    }

    match /calificaciones/{id} {
      // Leer: su dueño (el alumno), el staff de la academia, o el super. Un
      // alumno JAMÁS lee las de otro: la consulta del alumno filtra por su uid.
      allow get, list: if esSuper()
        || esDueno(resource.data.uid)
        || esStaffDe(resource.data.academiaId);
      // Escribir: SOLO el staff. El alumno no se califica a sí mismo, y por eso
      // no hay ninguna rama que le deje escribir aquí ni siquiera su propia
      // nota.
      //
      // `valor` entero de 0 a 100 validado en el servidor, igual que se hace con
      // el porcentaje de `intentos`: la validación del cliente sirve para no
      // ofrecer lo que se va a rechazar, no para decidir.
      allow create: if (esSuper() || esStaffDe(request.resource.data.academiaId))
        && request.resource.data.valor is int
        && request.resource.data.valor >= 0
        && request.resource.data.valor <= 100
        && request.resource.data.uid is string
        && request.resource.data.evaluacionId is string
        && request.resource.data.calificadoPor == request.auth.uid;
      // Al corregir una nota no se puede cambiar de quién es ni de qué
      // evaluación: eso sería mover una calificación de un alumno a otro.
      allow update: if (esSuper() || esStaffDe(resource.data.academiaId))
        && request.resource.data.valor is int
        && request.resource.data.valor >= 0
        && request.resource.data.valor <= 100
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.evaluacionId == resource.data.evaluacionId
        && request.resource.data.academiaId == resource.data.academiaId;
      allow delete: if esSuper() || esStaffDe(resource.data.academiaId);
    }

    match /intentos/{id} {
      // Crear: el propio alumno, con su uid y su academia (no puede falsear
      // otra) y con un RESULTADO consistente (Fase 4): nadie inventa un
      // porcentaje desde el cliente. Tolerancia de ±1 punto por el redondeo
      // (porcentaje = round(aciertos/total*100), como calcula la app).
      allow create: if autenticado()
        && request.resource.data.uid == request.auth.uid
        // perteneceA(): una prueba vencida no registra intentos en la academia.
        && perteneceA(request.resource.data.academiaId)
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 500
        && request.resource.data.aciertos is int
        && request.resource.data.aciertos >= 0
        && request.resource.data.aciertos <= request.resource.data.total
        && request.resource.data.porcentaje is int
        && request.resource.data.porcentaje >= 0
        && request.resource.data.porcentaje <= 100
        && request.resource.data.porcentaje * request.resource.data.total
             >= request.resource.data.aciertos * 100 - request.resource.data.total
        && request.resource.data.porcentaje * request.resource.data.total
             <= request.resource.data.aciertos * 100 + request.resource.data.total;
      // Leer: el dueño, el super-admin, o el staff de la misma academia.
      allow read: if esDueno(resource.data.uid)
        || esSuper()
        || esStaffDe(resource.data.academiaId);
      // Inmutables para los usuarios; el super-admin puede editarlos (p. ej.
      // migrar academiaId al cambiar el código de una academia) o borrarlos.
      allow update, delete: if esSuper();
    }

    // --- CONFIGURACIÓN global de la plataforma (solo super-admin) ---
    //  p. ej. configuracion/anuncio = banner que ven todos los usuarios.
    match /configuracion/{doc} {
      allow read: if true;         // el anuncio se muestra a cualquiera
      allow write: if esSuper();   // solo el super-admin lo edita
    }

    // ================= CONTENIDO MULTIACADEMIA (Fase 2) =================
    //  Plantillas GLOBALES (catálogo) + copia INDEPENDIENTE por academia.
    //  Nunca dos academias escriben el mismo doc: las plantillas son de solo
    //  lectura para todos menos el super-admin, y cada academia opera su
    //  copia (docs con SU academiaId; el academiaId es INMUTABLE, así que
    //  cambiarlo desde el cliente no permite apropiarse de documentos).

    // --- PLANTILLAS globales (catálogo oficial): SOLO super-admin ---
    // Nadie más las LEE siquiera (un alumno/director no enumera el catálogo
    // privado). El CONTENIDO (estructura) de una plantilla PUBLICADA es
    // inmutable incluso para el super-admin: se abre la versión siguiente
    // (el update de metadatos/estado/version sí se permite).
    match /plantillas/{plantillaId} {
      allow read, create, delete: if esSuper();
      allow update: if esSuper()
        && (
          resource.data.get('estado', 'borrador') != 'publicada'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estructura'])
        );
    }
    match /plantillasTemas/{docId} {
      allow read, write: if esSuper();
    }

    // --- VERSIONES publicadas de plantillas (snapshots INMUTABLES, Fase 7) ---
    // Se crean al publicar y JAMÁS se actualizan (ni el super-admin): son el
    // origen exacto de clonaciones/replicaciones y la base del rollback.
    // Borrar versiones usadas por academias se bloquea en la capa de datos
    // (versionEstaEnUso); las reglas permiten depurar solo al super-admin.
    match /plantillasVersiones/{docId} {
      allow read, create, delete: if esSuper();
      allow update: if false;
    }
    match /plantillasVersionesTemas/{docId} {
      allow read, create, delete: if esSuper();
      allow update: if false;
    }

    // --- OPERACIONES de replicación (auditoría de dry-run/aplicación/rollback) ---
    // Solo el super-admin: las academias no leen ni modifican reportes.
    match /replicaciones/{id} {
      allow read, write: if esSuper();
    }

    // --- CURSOS por academia (estructura ligera del temario) ---
    match /cursos/{cursoId} {
      // Leer: super-admin; staff de la academia (incluye borradores);
      // alumnos de la academia SOLO lo publicado Y DE SU PROGRAMA.
      // El id del doc de curso ES lo que apunta `grupos/{id}.programaId`.
      allow get, list: if esSuper()
        || esStaffDe(resource.data.academiaId)
        || alumnoLeeCurso(resource.data.academiaId, resource.data.estado, cursoId);
      // Crear: super-admin, o el DIRECTOR de su academia si su plan permite
      // editar contenido (base NO edita). El doc nace con SU academiaId,
      // firmado por su autor y con versión 1 (Fase 3).
      // Crear: el super-admin siempre. El DIRECTOR solo si su academia tiene
      // concedido crear programas de ESE tipo — ver `academiaCreaPrograma`.
      // Antes bastaba con que el plan permitiera editar contenido, así que
      // cualquier academia Pro podía crearse los cursos que quisiera. Eso no es
      // lo acordado: los programas propios se conceden uno a uno.
      allow create: if esSuper()
        || (esAdminDe(request.resource.data.academiaId)
            && academiaEditaContenido(request.resource.data.academiaId)
            && academiaCreaPrograma(request.resource.data.academiaId,
                                    request.resource.data.get('tipoPrograma', ''))
            && creacionContenidoValida());
      // Editar: mismo criterio + profesor con permiso sobre ESTE curso.
      // El academiaId es inmutable (nadie "adopta" cursos de otra academia)
      // y los editores no-super cumplen edicionContenidoValida (versión +1,
      // metadatos intocables, estado del catálogo). El profesor, además, solo
      // cambia el estado (publicar/archivar) con el permiso publicarContenido.
      allow update: if request.resource.data.academiaId == resource.data.academiaId
        && (
          esSuper()
          || (
            esAdminDe(resource.data.academiaId)
            && academiaEditaContenido(resource.data.academiaId)
            && edicionContenidoValida()
          )
          || (
            profesorPuedeEditar(resource.data.academiaId, cursoId)
            && edicionContenidoValida()
            && cursoSegunPermisos()
          )
        );
      // Sin eliminación destructiva por academias (archivar = update de estado).
      allow delete: if esSuper();
    }

    // --- TEMAS por academia (contenido pesado, 1 doc por tema) ---
    match /temas/{docId} {
      // Leer: super-admin; staff de la academia (incluye borradores);
      // alumnos de la academia SOLO temas publicados DE SU PROGRAMA (los
      // borradores no se filtran a los alumnos ni de su propia academia, y el
      // temario de otra carrera tampoco: el tema lleva su `cursoId`).
      allow get, list: if esSuper()
        || esStaffDe(resource.data.academiaId)
        || alumnoLeeCurso(resource.data.academiaId, resource.data.estado, resource.data.cursoId);
      // Crear: super; director PRO; o profesor con permiso de edición sobre el
      // curso Y el permiso crearTemas (crear un tema nuevo es "crear").
      allow create: if (esSuper()
          || (
            esAdminDe(request.resource.data.academiaId)
              && academiaEditaContenido(request.resource.data.academiaId)
              && creacionContenidoValida()
          )
          || (
            profesorPuedeEditar(request.resource.data.academiaId, request.resource.data.cursoId)
              && instructorPermite('crearTemas')
              && creacionContenidoValida()
          ))
        && request.resource.data.academiaId is string
        && request.resource.data.cursoId is string
        && request.resource.data.temaId is string;
      // academiaId, cursoId y temaId INMUTABLES: un tema no cambia de dueño
      // ni de curso desde el cliente (las llaves del progreso se preservan).
      // Los editores no-super cumplen además edicionContenidoValida; el
      // profesor, la rejilla FINA por campo (quiz/actividades/recursos/estado).
      allow update: if request.resource.data.academiaId == resource.data.academiaId
        && request.resource.data.cursoId == resource.data.cursoId
        && request.resource.data.temaId == resource.data.temaId
        && (
          esSuper()
          || (
            esAdminDe(resource.data.academiaId)
              && academiaEditaContenido(resource.data.academiaId)
              && edicionContenidoValida()
          )
          || (
            profesorPuedeEditar(resource.data.academiaId, resource.data.cursoId)
              && edicionContenidoValida()
              && camposTemaSegunPermisos()
          )
        );
      allow delete: if esSuper();
    }

    // --- AGREGADOS del curso (vistas derivadas precalculadas) ---
    //
    // Qué son: el glosario, el buscador, el banco de exámenes, el mazo de
    // flashcards, la galería y los contadores, ya calculados y guardados en
    // documentos pequeños. Existen para que abrir UNA lección no obligue a leer
    // las 287 del curso (ver src/lib/agregadosModelo.js).
    //
    // LEER: exactamente el mismo criterio que `temas`. Un agregado contiene
    // trozos de las lecciones —definiciones del glosario, preguntas del
    // examen—, así que no puede ser más accesible que el contenido del que
    // sale: si un alumno no puede leer el tema, tampoco su agregado.
    //
    // ESCRIBIR: quien puede editar el curso. Los datos NO se validan campo a
    // campo porque no los teclea nadie: los genera `escribirAgregadosDeCurso`
    // desde los temas que ya pasaron sus propias reglas. Lo que sí se protege
    // es que no cambien de dueño ni de curso.
    //
    // Sin `edicionContenidoValida()`, a diferencia de `cursos` y `temas`, y es
    // deliberado: esa función exige que CADA escritura suba la `version`, y
    // aquí hay una escritura que no lo hace —marcar el sello como caducado al
    // guardar una lección—. Exigirlo dejaría al profesor sin poder avisar de
    // que los agregados quedaron viejos, que es justo la señal que impide
    // servir a los alumnos el examen anterior al cambio. El bloqueo optimista
    // por versión no aporta nada en datos derivados: dos regeneraciones
    // simultáneas escriben lo mismo.
    match /agregados/{docId} {
      // EL DOCUMENTO QUE NO EXISTE. Leer un agregado ausente evaluaba
      // `resource.data.academiaId` sobre un `resource` nulo: eso es un error de
      // evaluación, y un error deniega. El cliente recibía `permission-denied`
      // en vez de «no existe».
      //
      // Tumbó la plataforma el 31-08-2026. El resolutor pregunta SIEMPRE por
      // `agregados/{curso}__sello` para decidir si puede servir por tema, y ese
      // sello no existía (ver P10). La lectura lanzaba, el resolutor no lo
      // capturaba, y todo lo que depende del contenido —abrir un tema, el
      // glosario, la página de logros— se quedaba cargando para siempre.
      //
      // El id del documento lleva la academia por delante
      // (`{academiaId}__{plantilla}__{tipo}`), así que cuando no hay documento
      // se decide con ella y no hace falta abrir la puerta a cualquiera: quien
      // pregunta tiene que ser staff de ESA academia, o alumno suyo. Lo único
      // que puede averiguar así es que el agregado no está, que es justo lo que
      // necesita saber para servir por el camino completo.
      allow get, list: if esSuper()
        || (
          resource == null
            ? (esStaffDe(docId.split('__')[0]) || perteneceA(docId.split('__')[0]))
            : (
              esStaffDe(resource.data.academiaId)
              || alumnoLeeCurso(resource.data.academiaId, resource.data.estado, resource.data.cursoId)
            )
        );

      allow create: if (esSuper()
          || (
            esAdminDe(request.resource.data.academiaId)
              && academiaEditaContenido(request.resource.data.academiaId)
          )
          || profesorPuedeEditar(request.resource.data.academiaId, request.resource.data.cursoId))
        && request.resource.data.academiaId is string
        && request.resource.data.cursoId is string
        && request.resource.data.tipo is string;

      // academiaId y cursoId INMUTABLES: un agregado no cambia de academia ni
      // se reasigna a otro curso desde el cliente.
      allow update: if request.resource.data.academiaId == resource.data.academiaId
        && request.resource.data.cursoId == resource.data.cursoId
        && (
          esSuper()
          || (
            esAdminDe(resource.data.academiaId)
              && academiaEditaContenido(resource.data.academiaId)
          )
          || profesorPuedeEditar(resource.data.academiaId, resource.data.cursoId)
        );

      allow delete: if esSuper();
    }

    // --- VALIDACIONES docentes aplicadas al temario ---
    //
    // UN documento por academia (`validaciones/{academiaId}`), más
    // `validaciones/_plataforma` para lo que se revisa fuera de toda academia.
    // Dentro, el mapa `temas: { temaId: { estado, revisadoPor, fecha, … } }`.
    //
    // LEER: abierto. El estado editorial es una etiqueta que existe PARA quien
    // lee la lección —«esto lo firmó un docente» o «esto aún no»— y el temario
    // se sirve también a quien no ha entrado con sesión. Cerrarlo dejaría al
    // visitante viendo un aviso de revisión sobre material ya validado.
    // Lo único que el documento contiene es esa etiqueta y el nombre o cargo
    // con el que el docente decidió firmarla, que es justamente lo que da la
    // cara por el contenido.
    //
    // ESCRIBIR: super-admin, o staff (profesor/director) de ESA academia. El
    // pase de revisión temporal se comprueba en la aplicación y no aquí: es un
    // control de flujo de trabajo entre gente de la misma escuela, no una
    // frontera de seguridad, y expresarlo en reglas exigiría comparar fechas
    // en texto contra request.time sin poder formatearla.
    match /validaciones/{docId} {
      allow read: if true;
      allow write: if esSuper() || esStaffDe(docId);
    }

    // --- TUTORIALES ya vistos ---
    //
    // Un documento por usuario (`tutoriales/{uid}`), con el mapa
    // `vistos: { clave: true }`. Cada pantalla se explica sola la primera vez y
    // esto es lo que recuerda que ya ocurrió, para que no vuelva a ocurrir en
    // otro dispositivo.
    //
    // POR QUÉ UNA COLECCIÓN PROPIA Y NO UN CAMPO EN `usuarios/{uid}`: la regla
    // de actualización de `usuarios` tiene una lista blanca estricta porque
    // cuando no la tenía, un alumno podía escribirse `modulosDesbloqueados` y
    // abrirse los módulos que su grupo tenía ocultos. Ensanchar esa lista para
    // guardar «ya vi el tutorial» sería abrir la puerta más sensible del
    // proyecto por el motivo más trivial. Aquí el peor caso posible es que
    // alguien se marque un tutorial como visto sin haberlo visto.
    //
    // Solo su dueño lo lee y lo escribe: no hay nada aquí que le interese a
    // nadie más, ni siquiera al staff de su academia.
    match /tutoriales/{uid} {
      allow read, write: if esDueno(uid);
    }

    // --- DICTÁMENES de revisión docente (validar / corregir) ---
    //
    // Un dictamen es la firma de un docente sobre un tema. Las de VALIDACIÓN
    // llegan ya aplicadas (ver `validaciones` arriba) y aquí quedan como
    // auditoría; las de corregir/reportar sí esperan trabajo. Basta con sesión
    // para crearlo (la app ya limita quién ve los botones) y se restringe a
    // staff/super quién lo LEE y quién lo RESUELVE.
    match /dictamenes/{id} {
      // Crear: usuario autenticado firmando con su uid, y siempre abierto.
      allow create: if autenticado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'abierto'
        && request.resource.data.temaId is string;
      // Leer: super-admin, o el staff de la academia del dictamen (el director
      // ve la cola; el profesor ve si alguien ya opinó sobre ese tema).
      allow read: if esSuper() || esStaffDe(resource.data.academiaId);
      // Resolver (aplicado / descartado): solo el director de esa academia o el
      // super-admin, y solo los campos de resolución: el dictamen firmado no se
      // reescribe.
      allow update: if (esSuper() || esAdminDe(resource.data.academiaId))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'notaResolucion', 'resueltoPor', 'resueltoEn'])
        && request.resource.data.estado in ['aplicado', 'descartado'];
      // Borrar: solo el super-admin, para depurar.
      allow delete: if esSuper();
    }

    // --- HISTORIAL de cambios de contenido (auditoría append-only) ---
    match /historial/{id} {
      // Crear: staff de la academia o super-admin, firmando con su uid.
      allow create: if request.resource.data.usuario == request.auth.uid
        && (esSuper() || esStaffDe(request.resource.data.academiaId));
      // Leer: super-admin o el director de esa academia.
      allow read: if esSuper() || esAdminDe(resource.data.academiaId);
      // Append-only: nadie edita; solo el super-admin puede depurar.
      allow delete: if esSuper();
    }

    // --- RESPALDOS previos a sobrescrituras (los usa la replicación, Fase 9) ---
    match /respaldos/{id} {
      allow read, write: if esSuper();
    }
  }
}
